{
  "name": "omni-electron",
  "version": "0.1.0",
  "description": "Self-improving AI assistant - Electron desktop app",
  "main": "electron/main.js",
  "type": "module",
  "scripts": {
    "dev": "concurrently \"npm run dev:vite\" \"npm run dev:electron\"",
    "dev:vite": "vite",
    "dev:electron": "wait-on http://localhost:5173 && electron .",
    "build": "vite build && electron-builder",
    "build:linux": "vite build && electron-builder --linux",
    "build:analyze": "vite build && echo '\\nBundle analysis available at: dist/stats.html'",
    "preview": "vite preview"
  },
  "keywords": [
    "ai",
    "assistant",
    "electron",
    "self-improving",
    "autonomous"
  ],
  "author": {
    "name": "Mathijs van den Hurk",
    "email": "mathijs@example.com"
  },
  "license": "MIT",
  "dependencies": {
    "@codemirror/autocomplete": "^6.19.1",
    "@codemirror/commands": "^6.10.0",
    "@codemirror/lang-css": "^6.3.1",
    "@codemirror/lang-html": "^6.4.11",
    "@codemirror/lang-javascript": "^6.2.4",
    "@codemirror/lang-json": "^6.0.2",
    "@codemirror/lang-markdown": "^6.5.0",
    "@codemirror/lang-python": "^6.2.1",
    "@codemirror/language": "^6.11.3",
    "@codemirror/lint": "^6.9.2",
    "@codemirror/search": "^6.5.11",
    "@codemirror/state": "^6.5.2",
    "@codemirror/theme-one-dark": "^6.1.3",
    "@codemirror/view": "^6.38.6",
    "marked": "^12.0.2",
    "prismjs": "^1.30.0",
    "vue": "^3.5.12"
  },
  "devDependencies": {
    "@types/marked": "^5.0.2",
    "@types/prismjs": "^1.26.5",
    "@vitejs/plugin-vue": "^5.1.4",
    "concurrently": "^9.0.1",
    "cssnano": "^7.1.2",
    "dotenv": "^16.6.1",
    "electron": "^33.0.2",
    "electron-builder": "^25.1.7",
    "lightningcss": "^1.30.2",
    "rollup-plugin-visualizer": "^6.0.5",
    "terser": "^5.44.1",
    "typescript": "^5.6.3",
    "vite": "^6.0.1",
    "vue-tsc": "^3.1.3",
    "wait-on": "^8.0.1"
  },
  "build": {
    "appId": "com.mathijs.omni",
    "productName": "Omni",
    "directories": {
      "output": "dist-electron"
    },
    "files": [
      "dist/**/*",
      "electron/**/*",
      "backend/**/*"
    ],
    "linux": {
      "target": [
        "AppImage",
        "deb"
      ],
      "category": "Development",
      "icon": "build/icon.png"
    }
  }
}
